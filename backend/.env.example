# PostgreSQL connection string for the API and Alembic.
# Neon and other hosts may use postgres:// or postgresql://; include
# ?sslmode=require when the provider requires TLS (Neon defaults do).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Application environment: development (default) or production.
APP_ENV=development

# Comma-separated browser origins allowed to call the API (CORS).
# Required when APP_ENV=production. Optional in development; defaults to
# http://localhost:4200 when unset.
# CORS_ORIGINS=http://localhost:4200,https://YOUR-FRONTEND-ORIGIN.example

# Auth0 (required for the API outside local tests).
# AUTH0_DOMAIN=your-tenant.us.auth0.com
# AUTH0_AUDIENCE=https://api.personal-finance
# Optional offline JWKS for automated tests only:
# AUTH0_JWKS_JSON={"keys":[...]}
